// ============================================================
// ISCRIPT Domänengrammatik: Fachpublikation
// Datei: domains/fachpublikation/grammatik.isc
//
// Grundlage:
//   - DITA 2.0 (Topic-Typen: concept, task, reference)
//     https://docs.oasis-open.org/dita/v2.0/os/en/dita-v2.0.html
//   - SPAR (Semantic Publishing and Reference) Ontologien
//     https://sparontologies.github.io/
//
// Diese Grammatik definiert, WAS ein Fachartikel strukturell ist.
// Sie sagt NICHT, wie er klingt — das ist die Sache des Kontexts.
// ============================================================

domain fachpublikation {

  // ----------------------------------------------------------
  // METADATEN (SPAR-basiert)
  // ----------------------------------------------------------
  // SPAR: Author, Publication, Citation
  // Diese Felder sind invariant (faktum) — der Kontext darf sie
  // nicht verändern, nur präsentieren.

  spar: {
    // SPAR:Creator (Person oder Organisation)
    autor: {
      name: string,          // SPAR:Creator.name
      organisation: string?, // SPAR:Organization
      affiliation: string?   // SPAR:Affiliation
    },
    // SPAR:Publication
    publikation: {
      titel: string,         // SPAR:Publication.title
      titelLang: "de"|"en"?, // Sprache des Titels
      zeitraum: {            // SPAR:Publication.date
        von: date,
        bis: date?
      },
      ort: string?,          // Publikationsort
      issn: string?,         // bei Zeitschriften
      urn: string?           // SPAR:Resource.urn (permanente Zitation)
    },
    // SPAR:Work
    werk: {
      typ: "aufsatz"|"buch"|"kapitel"|"whitepaper",
      sprache: string,       // ISO 639-1
      zitation: {            // SPAR:Quotation
        stil: "chicagoo"|"apa"|"ieee"|"dpg",
        format: string       // vorgeformte Zitationszeile
      }
    }
  }

  // ----------------------------------------------------------
  // ARTIKELSTRUKTUR (DITA-basiert)
  // ----------------------------------------------------------
  // DITA Topic: title + shortdesc + conbody
  // Jeder Artikel ist ein DITA-Topic vom Typ "concept",
  // das task- und reference-Teile enthalten kann.

  artikel {
    // DITA: topic/title (invariant)
    titel: string,

    // DITA: topic/shortdesc (invariant — die These in einem Satz)
    these: string,

    // DITA: topic/conbody — der eigentliche Inhalt
    // Strukturiert als Liste von DITA-Teilen.
    teile: [

      // DITA: <concept> — erklärt, WAS etwas ist
      concept {
        name: string,            // Identifikation des Begriffs
        definition: string,      // Invariante Definition (faktum)
        begrifflich: ?{}         // Kontextabhängig: Begriffsverwandtschaft,
                                 // Beispiele, Abgrenzung zu Nachbarbegriffen
      },

      // DITA: <task> — erklärt, WIE man etwas tut
      task {
        name: string,
        vorraussetzung: string?, // DITA: task/prereq
        schritte: [              // DITA: task/step
          { anleitung: string,   // DITA: step/cmd
            ergebnis: string? } // DITA: step/result
        ],
        hinweise: ?{}            // Kontextabhängig: Tipps, Warnungen,
                                 // Alternativen je nach Publikum
      },

      // DITA: <reference> — dokumentiert, WAS existiert (Nachschlagewerk)
      reference {
        name: string,
        eintraege: [             // DITA: referenceentry
          { schluessel: string,
            wert: string,
            einheit: string? }
        ],
        bemerkung: ?{}           // Kontextabhängig: Interpretation der
                                 // Werte, Abhängigkeit von Voraussetzungen
      },

      // Freier DITA-Body-Text (Absätze, Listen, Tabellen)
      absatz {
        inhalt: string,
        kontext: ?{}             // Kontextabhängig: welche Absätze betonen,
                                 // kürzen, umformulieren
      }
    ]

    // ----------------------------------------------------------
    // KONTINGENTIERUNG (Invariantensicherung)
    // ----------------------------------------------------------
    // Definiert, welche Felder der Kontext NICHT verändern darf.
    // Dies ist die Antwort auf offene Frage 3 aus der
    // Projektdokumentation.
    invarianzen {
      // Diese Felder sind faktum — der Kontext darf sie nur
      // auswählen/presentieren, aber nie verändern:
      faktum: [
        "spar.autor.name",
        "spar.autor.organisation",
        "spar.publikation.titel",
        "spar.publikation.zeitraum",
        "artikel.titel",
        "artikel.teile[].concept.definition",
        "artikel.teile[].task.schritte[].anleitung",
        "artikel.teile[].reference.eintraege[].wert"
      ]
      // Der Kontext KANN beeinflussen:
      rahmung: [
        "artikel.teile[].concept.begrifflich",
        "artikel.teile[].task.hinweise",
        "artikel.teile[].reference.bemerkung",
        "artikel.teile[].absatz.kontext"
      ]
    }
  }

  // ----------------------------------------------------------
  // KONTIX-PARAMETER (was der Kontext steuern kann)
  // ----------------------------------------------------------
  // Diese Parameter werden aus dem freien Kontexttext extrahiert
  // und steuern die Auflösung. Sie sind die Schnittstelle
  // zwischen freier Sprache und Struktur.
  kontextparameter {
    // Publikum: wer liest den Artikel?
    publikum: {
      typ: "fachpublikum"|"allgemein"|"studenten"|"management",
      fachkenntnisse: 1..5    // 1=Laie, 5=Experte
    },
    // Ton: wie klingt der Artikel?
    ton: {
      stil: "sachlich"|"erzaehlend"|"ueberzeugend"|"kritisch",
      person: "ich"|"wir"|"erz"  // Ich-Form, Wir-Form, Erzähler
    },
    // Länge: wie ausführlich?
    laenge: {
      ziel: string?,         // z.B. "4000 Wörter"
      struktur: string?,     // z.B. "5 H2-Teile"
      komprimierung: "voll"|"dicht"|"kern"  // Kürzungsgrad
    },
    // Fokus: worauf konzentrieren?
    fokus: {
      gewichtung: [           // Priorisierung der Teiltypen
        { teil: "concept"|"task"|"reference"|"absatz",
          gewicht: 1..5 }
      ],
      ausschließe: string?   // Was soll bewusst weggelassen werden?
    }
  }

  // ----------------------------------------------------------
  // AUFLÖSUNGSREGELN (minimale, regelbasierte Logik)
  // ----------------------------------------------------------
  // Diese Regeln steuern, wie Code + Kontext → Artefakt.
  // Sie sind deterministisch und nachvollziehbar.
  auflösung {
    // Regel 1: Definitionen sind invariant — Kontext darf sie
    // nur ergänzen, nie ersetzen.
    regel("definition_invariant") {
      bedingung:  artikel.teile[].concept.definition ist gesetzt
      aktion:     kontext darf definition nur durch begrifflich ergänzen
      verletzung: auflösung schlägt fehl mit "Invarianz verletzt: definition"
    }

    // Regel 2: Publikation-Metadaten sind invariant
    regel("metadaten_invariant") {
      bedingung:  spar.autor.name UND spar.publikation.titel sind gesetzt
      aktion:     kontext darf Metadaten nur formatieren (Zitationsstil)
      verletzung: auflösung schlägt fehl mit "Invarianz verletzt: spar"
    }

    // Regel 3: Kontext-Priorisierung — Teile mit höherem Gewicht
    // erscheinen zuerst und ausführlicher
    regel("fokus_prioritaet") {
      bedingung:  kontextparameter.fokus.gewichtung ist gesetzt
      aktion:     teile werden nach gewicht sortiert;
                  teile mit gewicht ≥ 4 erhalten ausführliche Behandlung;
                  teile mit gewicht ≤ 2 werden komprimiert
    }

    // Regel 4: Komprimierungsgrad bestimmt, wie viel Kontext
    // in den Output fließt
    regel("komprimierung") {
      bedingung:  kontextparameter.laenge.komprimierung ist gesetzt
      aktion:
        "voll"  → alle ?{}-Felder vollständig aufgelöst
        "dicht" → ?{}-Felder: nur Kerninformationen
        "kern"  → ?{}-Felder: auf maximal 1 Satz pro Feld reduziert
    }

    // Regel 5: Ton steuert Satzbau und Wortschatz
    regel("ton_satzbau") {
      bedingung:  kontextparameter.ton.stil ist gesetzt
      aktion:
        "sachlich"      → kurze Sätze, aktive Verbform, keine Füllwörter
        "erzaehlend"    → längere Sätze, Beispiele, Anekdote erlaubt
        "ueberzeugend"  → Appell-Satzform, rhetorische Fragen erlaubt
        "kritisch"      → Gegenpositionen werden explizit benannt
    }
  }
}
